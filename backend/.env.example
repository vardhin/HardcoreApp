# HardcoreAI backend configuration.
# Copy this file to `.env` and fill in the real password.
#
# Get the password from Supabase: Project Settings -> Database -> Connection string.
# The pooler host (port 6543) is recommended for serverless; 5432 is the direct
# connection. Either works for a long-running FastAPI process.

# Supabase Postgres connection string.
# Replace YOUR-PASSWORD with the database password (NOT the anon key).
DATABASE_URL=postgresql+psycopg://postgres:YOUR-PASSWORD@db.valyxxcifulxzlzoqiuq.supabase.co:5432/postgres

# Supabase project URL and anon/publishable key (used by the frontend; kept
# here for reference / future server-side Supabase client use).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# AI agent — LLM providers. The agent (POST /api/projects/{id}/agent/solve)
# can use any of three backends; pick one per request from the frontend panel.
# ---------------------------------------------------------------------------

# llama.cpp — local OpenAI-compatible server. Run Prism Bonsai 8B (1-bit quant):
#   llama-server -m prism-bonsai-8b-q1.gguf --port 8080
# No API key needed. LLAMACPP_MODEL is the id the server reports.
LLAMACPP_URL=http://localhost:8080
LLAMACPP_MODEL=prism-bonsai-8b-1bit

# OpenRouter — cloud. Uses openai/gpt-oss-120b. Get a key at openrouter.ai/keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b

# Google Gemini — uses gemini-2.5-flash. Key from aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth (for Supabase authentication)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
